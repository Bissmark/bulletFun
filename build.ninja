build dist/BulletFun.html: CXX_EXECUTABLE_LINKER__BulletFun_Release CMakeFiles/BulletFun.dir/src/main.cpp.o CMakeFiles/BulletFun.dir/src/player.cpp.o CMakeFiles/BulletFun.dir/src/enemy.cpp.o CMakeFiles/BulletFun.dir/src/enemySpawner.cpp.o CMakeFiles/BulletFun.dir/src/bullet.cpp.o CMakeFiles/BulletFun.dir/src/archer.cpp.o CMakeFiles/BulletFun.dir/src/grunt.cpp.o CMakeFiles/BulletFun.dir/src/slime.cpp.o CMakeFiles/BulletFun.dir/src/abilityManager.cpp.o CMakeFiles/BulletFun.dir/src/background.cpp.o CMakeFiles/BulletFun.dir/src/characterSelection.cpp.o CMakeFiles/BulletFun.dir/src/auraDmg.cpp.o CMakeFiles/BulletFun.dir/src/fireBreath.cpp.o CMakeFiles/BulletFun.dir/src/rotatingBalls.cpp.o CMakeFiles/BulletFun.dir/src/blizzard.cpp.o CMakeFiles/BulletFun.dir/src/levelUp.cpp.o CMakeFiles/BulletFun.dir/src/powerup.cpp.o CMakeFiles/BulletFun.dir/src/skillBar.cpp.o CMakeFiles/BulletFun.dir/src/skillPickup.cpp.o CMakeFiles/BulletFun.dir/src/slash.cpp.o CMakeFiles/BulletFun.dir/src/terrainCollisionDetection.cpp.o CMakeFiles/BulletFun.dir/src/rlImGui.cpp.o CMakeFiles/BulletFun.dir/src/imgui.cpp.o CMakeFiles/BulletFun.dir/src/imgui_widgets.cpp.o CMakeFiles/BulletFun.dir/src/imgui_draw.cpp.o CMakeFiles/BulletFun.dir/src/imgui_tables.cpp.o CMakeFiles/BulletFun.dir/src/imgui_demo.cpp.o CMakeFiles/BulletFun.dir/src/inGameMenu.cpp.o | lib/libraylib.a
  FLAGS = -O3 -DNDEBUG
  LINK_FLAGS = -sUSE_GLFW=3 -sASSERTIONS=1 -sWASM=1 -sASYNCIFY -sGL_ENABLE_GET_PROC_ADDRESS=1 -sEXPORTED_FUNCTIONS=[\"_main\"] -sEXPORTED_RUNTIME_METHODS=[\"ccall\",\"cwrap\"] -sFORCE_FILESYSTEM --preload-file=C:/Users/Gosh_/Desktop/Programming/Projects/C++/Raylib/BulletFun/Spritesheet@/Spritesheet --preload-file=C:/Users/Gosh_/Desktop/Programming/Projects/C++/Raylib/BulletFun/Tileset@/Tileset
  LINK_LIBRARIES = lib/libraylib.a
  OBJECT_DIR = CMakeFiles\BulletFun.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = dist\BulletFun.html
  TARGET_PDB = BulletFun.html.dbg


