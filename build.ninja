  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\Gosh_\Desktop\Programming\Projects\C++\Raylib\BulletFun && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\Users\Gosh_\Desktop\Programming\Projects\C++\Raylib\BulletFun -BC:\Users\Gosh_\Desktop\Programming\Projects\C++\Raylib\BulletFun"
